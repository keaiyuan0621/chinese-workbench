# 复制为 .env 后填入真实值（.env 已被 git 忽略，不会提交）
# Vite 只会把 VITE_ 前缀的变量注入到前端

# Supabase 项目设置 → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 课件文件的 Storage 桶名（默认 course-materials）
VITE_SUPABASE_MATERIALS_BUCKET=course-materials

# 简答题 AI 批改接口（后续接入时使用，当前仅预留）
VITE_AI_GRADING_ENDPOINT=

# 题目识别接口（可选）。不填时，按正文里的题号、选项、答案、解析识别，
# 知识点仍限制在黄伯荣、廖序东《现代汉语》增订七版的节次内。
VITE_AI_QUESTION_ENDPOINT=
