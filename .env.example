# 复制为 .env 后填入真实值（.env 已被 git 忽略，不会提交）
# Vite 只会把 VITE_ 前缀的变量注入到前端

# Supabase 项目设置 → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 课件文件的 Storage 桶名（默认 course-materials）
VITE_SUPABASE_MATERIALS_BUCKET=course-materials

# 简答题 AI 批改接口（后续接入时使用，当前仅预留）
VITE_AI_GRADING_ENDPOINT=

# 题目识别接口（可选）。不填时，按正文里的题号、选项、答案、解析识别，
# 知识点仍限制在黄伯荣、廖序东《现代汉语》增订七版的节次内。
VITE_AI_QUESTION_ENDPOINT=

# 学生端 AI 双角色讲解。设为 false 时隐藏入口，只保留原解析。
# 默认展示入口；服务未配置时会诚实提示，不会用模板假装 AI 回复。
VITE_AI_TUTORS_ENABLED=

# 以下仅服务端 / Netlify Function / 本地 Vite 代理使用，不要加 VITE_ 前缀。
# DEEPSEEK_API_KEY=
# AI_TUTORS_ENABLED=true
# AI_TUTORS_TIMEOUT_MS=18000
# SUPABASE_URL=   # 可省略，函数会回退到 VITE_SUPABASE_URL
# SUPABASE_ANON_KEY=  # 可省略，函数会回退到 VITE_SUPABASE_ANON_KEY
